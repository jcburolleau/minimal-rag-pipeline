OPENAI_API_KEY=
EMBED_MODEL=text-embedding-3-small
CHAT_MODEL=gpt-4o-mini
TOP_K=5

# Ingest: markdown (header + length split, collection "northline")
# or llm (LLM pre-processing, collection "northline_llm"). The app reads the matching collection.
CHUNKER=markdown
# Model for LLM pre-processing; empty uses CHAT_MODEL.
PREPROCESS_MODEL=

# Advanced retrieval, all off by default. Pick them from the retrieval eval.
REWRITE_QUERY=false
EXPAND_QUERY=false
EXPAND_N=3
RERANK=false
CANDIDATE_K=20
